{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tulina.app/contracts/v1/facility.schema.json",
  "title": "Facility v1",
  "type": "object",
  "required": ["facility_id", "official_name", "care_rank", "district"],
  "properties": {
    "facility_id": {"type": "string", "pattern": "^F[0-9]{2}$"},
    "official_name": {"type": "string", "minLength": 1},
    "short_name": {"type": "string", "minLength": 1},
    "care_rank": {"type": "integer", "minimum": 1},
    "district": {"type": "string", "minLength": 1}
  }
}
