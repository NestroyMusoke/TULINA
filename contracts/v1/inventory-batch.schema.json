{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tulina.app/contracts/v1/inventory-batch.schema.json",
  "title": "Inventory batch v1",
  "type": "object",
  "required": ["batch_id", "facility_id", "product_id", "batch_number", "qty_on_hand", "expiry_date", "quality_status"],
  "properties": {
    "batch_id": {"type": "string", "pattern": "^BAT-"},
    "facility_id": {"type": "string", "pattern": "^F[0-9]{2}$"},
    "product_id": {"type": "string", "pattern": "^P[0-9]{2}$"},
    "batch_number": {"type": "string", "minLength": 1},
    "qty_on_hand": {"type": "integer", "minimum": 0},
    "expiry_date": {"type": "string", "format": "date"},
    "quality_status": {"enum": ["AVAILABLE", "QUARANTINED", "EXPIRED"]}
  }
}
