{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tulina.example/contracts/v1/offline-verification-report.schema.json",
  "title": "Offline verification report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transfer_id",
    "capsule_id",
    "device_id",
    "decision",
    "reason_code",
    "occurred_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "transfer_id": { "type": "string", "pattern": "^TR-[0-9]{3}$" },
    "capsule_id": { "type": "string", "pattern": "^CAP-" },
    "device_id": { "type": "string", "pattern": "^DEV-" },
    "decision": { "const": "REJECT_OFFLINE" },
    "reason_code": {
      "enum": [
        "PAYLOAD_UNREADABLE",
        "ISSUER_KEY_NOT_TRUSTED",
        "SIGNATURE_INVALID",
        "RECIPIENT_MISMATCH",
        "NOTE_EXPIRED",
        "NONCE_ALREADY_USED_LOCAL"
      ]
    },
    "occurred_at": { "type": "string", "format": "date-time" }
  }
}
