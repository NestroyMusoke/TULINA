{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tulina.local/contracts/v1/tulina-note.schema.json",
  "title": "Signed Tulina Note",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "key_id", "canonical_payload", "signature_base64url", "qr_payload", "payload", "signature_format", "source_label"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "key_id": { "type": "string", "minLength": 1 },
    "canonical_payload": { "type": "string", "minLength": 2 },
    "signature_base64url": { "type": "string", "minLength": 80, "maxLength": 96 },
    "qr_payload": { "type": "string", "pattern": "^TULINA1\\." },
    "signature_format": { "const": "IEEE_P1363_64_BYTE" },
    "source_label": { "type": "string" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "capsule_id", "transfer_id", "issuer", "donor", "recipient", "product", "batch", "qty", "approval", "iat", "exp", "nonce"],
      "properties": {
        "v": { "const": 1 },
        "capsule_id": { "type": "string", "pattern": "^CAP-" },
        "transfer_id": { "type": "string", "pattern": "^TR-[0-9]{3}$" },
        "issuer": { "type": "string" },
        "donor": { "type": "string", "pattern": "^F[0-9]{2}$" },
        "recipient": { "type": "string", "pattern": "^F[0-9]{2}$" },
        "product": { "type": "string", "pattern": "^P[0-9]{2}$" },
        "batch": { "type": "string", "pattern": "^BAT-" },
        "qty": { "type": "integer", "minimum": 1 },
        "approval": { "type": "string", "pattern": "^APR-" },
        "iat": { "type": "string", "format": "date-time" },
        "exp": { "type": "string", "format": "date-time" },
        "nonce": { "type": "string", "minLength": 12, "maxLength": 128 }
      }
    }
  }
}
