# Local fixture mode works with no credentials.
TULINA_MODE=fixture
TULINA_DATABASE_PATH=data/runtime/tulina.sqlite3
TULINA_ALLOWED_ORIGINS=http://localhost:5173
TULINA_DEMO_AUTH=true
VITE_API_URL=http://localhost:8080
VITE_DEMO_MODE=true

# Live Gemini mode (choose API key or Vertex AI).
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-3.5-flash

# GCP adapters.
TULINA_REPOSITORY=local
TULINA_QUEUE=local
TULINA_AGENT_STEP_DELAY_MS=80
TULINA_GCP_PROJECT=
TULINA_PUBSUB_TOPIC=tulina-workflows
TULINA_KMS_KEY_VERSION=
